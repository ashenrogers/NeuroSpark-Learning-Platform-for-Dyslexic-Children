# Backend Configuration
# Copy this file to .env and fill in your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Speech Recognition Settings
USE_WHISPER=True
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large

# Google Cloud Speech API (Optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# AI Model Settings (For future LLM integration)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Database (For production)
# DATABASE_URL=postgresql://user:password@localhost/dyslexia_db

# CORS Settings
ALLOWED_ORIGINS=*  # In production, specify exact origins

# File Upload Settings
MAX_FILE_SIZE_MB=10
ALLOWED_AUDIO_FORMATS=.wav,.mp3,.m4a

# Scoring Thresholds
PRONUNCIATION_THRESHOLD=0.75
FLUENCY_THRESHOLD=0.60
